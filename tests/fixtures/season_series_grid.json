     {"id": "e", "status": "post", "statusType": {"completed": false, "state": "post", "name": "STATUS_POSTPONED"}, "competitors": [{"homeAway": "home", "winner": true, "team": {"id": "1"}}, {"homeAway": "away", "winner": false, "team": {"id": "2"}}]}
